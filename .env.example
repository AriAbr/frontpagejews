# Copy to .env and fill in. .env is gitignored; nothing here is committed with a value.

# Port `make web` binds runserver to. Machine-specific -- pick anything free.
# Temporary: goes away when the project moves behind the hostname-based proxy.
PORT=

# Generate with:
#   python -c 'from django.core.management.utils import get_random_secret_key as k; print(k())'
SECRET_KEY=

DEBUG=True
DJANGO_ENV=dev

# Google Analytics (G-...). Leave empty locally; the deploy workflow sets it.
GA_MEASUREMENT_ID=

# The NYT's API key, for fetch_nyt; from developer.nytimes.com. The deploy
# workflow sets it from a repository secret.
NYT_API_KEY=

# A GeoNames username, for fetch_nyt's place lookups; from geonames.org, with
# "free web services" turned on in the account. The deploy workflow sets it
# from a repository secret.
GEONAMES_USERNAME=

# Sentry DSN. Leave empty locally; the deploy workflow sets it.
SENTRY_DSN=
