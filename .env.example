# Copy to .env and fill in. .env is gitignored; nothing here is committed with a value.

# Port `make web` binds runserver to. Machine-specific -- pick anything free.
# Temporary: goes away when the project moves behind the hostname-based proxy.
PORT=

# Generate with:
#   python -c 'from django.core.management.utils import get_random_secret_key as k; print(k())'
SECRET_KEY=

DEBUG=True
DJANGO_ENV=dev
